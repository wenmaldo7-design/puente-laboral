# Copiar a .env y completar con valores reales. .env nunca se commitea
# (ver .gitignore) ni se copia dentro de la imagen Docker (ver .dockerignore):
# docker-compose lo inyecta en runtime via env_file.

# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://usuario:password@host:5432/postgres?pgbouncer=true"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://usuario:password@host:5432/postgres"

JWT_SECRET=
COOKIE_SECRET=

# SMTP (mail transaccional - notificacion de rechazo de solicitud de empresa)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
